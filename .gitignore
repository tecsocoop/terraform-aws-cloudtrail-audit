# Local Terraform directories
**/.terraform/*

# Terraform dependency lock file for a reusable module
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
tfplan
plan.out

# Terraform crash logs
crash.log
crash.*.log

# Variable files can contain sensitive values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration files
.terraformrc
terraform.rc
